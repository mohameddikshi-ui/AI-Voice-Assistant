apply plugin: 'com.android.library'

repositories {

    mavenLocal()

    google()

    mavenCentral()

    maven {

        url "$projectDir/../node_modules/react-native/android"
    }

    maven {

        url "$projectDir/../../react-native/android"
    }
}

android {

    compileSdkVersion 34

    defaultConfig {

        minSdkVersion 21

        targetSdkVersion 34

        versionCode 1

        versionName "1.0"
    }
}

buildscript {

    repositories {

        google()

        mavenCentral()
    }

    dependencies {

        classpath 'com.android.tools.build:gradle:8.0.0'
    }
}

allprojects {

    repositories {

        google()

        mavenCentral()
    }
}

dependencies {

    implementation fileTree(
        dir: 'libs',
        include: ['*.jar']
    )

    implementation 'com.facebook.react:react-native:+'
}